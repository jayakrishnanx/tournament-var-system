SECRET_KEY=django-insecure-tournament-var-system-dev-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True

# Database Configuration
# You can provide a single cloud DATABASE_URL (e.g. Supabase, Neon, Render Postgres, Google Cloud SQL)
DATABASE_URL=
USE_POSTGRES=False
DB_NAME=var_db
DB_USER=var_user
DB_PASSWORD=var_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration (For Channels WebSockets)
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS=False
